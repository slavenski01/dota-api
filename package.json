{
  "name": "dota-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "26.3.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@dota/contracts && npm run build --workspace=@dota/analysis && npm run build --workspace=@dota/persistence && npm run build --workspace=@dota/jobs",
    "build:ts": "npm run build:packages && npm run build --workspace=@dota/worker && npm run build --workspace=@dota/web",
    "build:parser": "./services/replay-parser/gradlew --project-dir services/replay-parser --no-daemon build installDist",
    "build": "npm run build:ts && npm run build:parser",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1",
    "dev:worker": "node --env-file-if-exists=.env --watch --max-old-space-size=256 apps/worker/src/index.ts",
    "start:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web --hostname 127.0.0.1",
    "start:worker": "node --env-file-if-exists=.env --max-old-space-size=256 apps/worker/dist/index.js",
    "start:parser": "./services/replay-parser/build/install/replay-parser/bin/replay-parser",
    "smoke": "node --test scripts/smoke.test.mjs",
    "test:contracts": "node --test scripts/contracts.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:persistence": "node scripts/test-postgres.mjs scripts/persistence.test.mjs",
    "test:storage": "node scripts/test-postgres.mjs scripts/storage.test.mjs",
    "test:jobs": "node scripts/test-postgres.mjs scripts/jobs.test.mjs",
    "test:workflow": "node scripts/test-postgres.mjs scripts/workflow.test.mjs",
    "test:postgres-harness": "node --test scripts/postgres-harness.test.mjs",
    "test:profiles": "node scripts/test-postgres.mjs scripts/profiles.test.mjs",
    "test:history": "node scripts/test-postgres.mjs scripts/history.test.mjs",
    "test:match-list": "node scripts/test-postgres.mjs scripts/match-list.test.mjs",
    "test:profile-web": "node scripts/test-postgres.mjs scripts/profile-web.test.mjs",
    "test:replay-source": "node scripts/test-postgres.mjs scripts/replay-source.test.mjs",
    "test:replay-import": "node scripts/test-postgres.mjs scripts/replay-import.test.mjs",
    "test:replay-web": "node scripts/test-postgres.mjs scripts/replay-web.test.mjs",
    "test:normalization": "node scripts/test-postgres.mjs scripts/normalization.test.mjs",
    "test:coverage": "node --test scripts/coverage.test.mjs",
    "test:player-context": "node --test scripts/player-context.test.mjs",
    "test:metrics": "node --test scripts/metrics.test.mjs",
    "test:death-rules": "node --test scripts/death-rules.test.mjs",
    "test:item-fight-rules": "node --test scripts/item-fight-rules.test.mjs",
    "test:episodes": "node --test scripts/episodes.test.mjs",
    "test:analysis-integration": "node scripts/test-postgres.mjs scripts/analysis-integration.test.mjs",
    "test:match-view": "node scripts/test-postgres.mjs scripts/match-view.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
