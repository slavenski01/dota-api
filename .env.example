# Server settings. db:migrate and web/worker commands read .env.
# Source and LLM adapters are connected in subsequent epics.
# Never prefix secret settings with NEXT_PUBLIC_.
DATABASE_URL=postgresql://dota:local-example-password@127.0.0.1:5432/dota
STORAGE_ROOT=./data/storage
OPENDOTA_API_KEY=
STEAM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
