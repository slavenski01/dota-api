# Server settings. db:migrate and web/worker commands read .env.
# Never prefix secret settings with NEXT_PUBLIC_.
# Compose: generated by `node scripts/local.mjs init`; hex only (URL safe).
POSTGRES_PASSWORD=
DOTA_PORT=3000
# Optional outbound HTTP proxy reachable FROM containers (not host loopback).
DOTA_HTTP_PROXY=
# Direct development only; Compose supplies its internal connection automatically.
DATABASE_URL=postgresql://dota:local-example-password@127.0.0.1:5432/dota
STORAGE_ROOT=./data/storage
OPENDOTA_API_KEY=
# OpenDota is the metadata source, Valve CDN supplies replays. No LLM required.
