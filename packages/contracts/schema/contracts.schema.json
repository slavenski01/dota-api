{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dota.invalid/schema/contracts-0.1.0.json",
  "title": "ContractDocument",
  "description": "Draft data contract 0.1.0 and NDJSON protocol 1.0.0; no proof of replay extraction capabilities.",
  "oneOf": [
    {
      "$ref": "#/definitions/ContractRecord"
    },
    {
      "$ref": "#/definitions/ProtocolRequest"
    },
    {
      "$ref": "#/definitions/ProtocolMessage"
    }
  ],
  "definitions": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "DecimalId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "Team": {
      "enum": [
        "radiant",
        "dire"
      ]
    },
    "PlayerSlot": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        128,
        129,
        130,
        131,
        132
      ]
    },
    "Window": {
      "type": "object",
      "properties": {
        "startSeconds": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "endSeconds": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "startSeconds",
        "endSeconds"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "replay",
            "opendota",
            "steam",
            "manual",
            "derived",
            "fixture"
          ]
        },
        "acquiredAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "artifactId": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "acquiredAt",
        "artifactId",
        "sourceVersion",
        "inputIds"
      ],
      "additionalProperties": false
    },
