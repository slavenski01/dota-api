              "type": "boolean"
            },
            "observedAtSeconds": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "status",
            "value",
            "observedAtSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "unavailable",
                "error"
              ]
            },
            "value": {
